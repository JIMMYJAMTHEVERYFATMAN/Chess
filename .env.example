# Generate the RSA keypair with `python generate_dashboard_keys.py`.
# Keep the private key local and configure the public key as TELEMETRY_PUBLIC_KEY
# in the collector's runtime environment.
OFFLINE_CHESS_DASHBOARD_PRIVATE_KEY=C:\Users\YOUR_NAME\AppData\Local\OfflineChess\dashboard-private.pem
# Path to your local clone of the private telemetry repository.
OFFLINE_CHESS_DATA_REPO=C:\Users\YOUR_NAME\Documents\offline-chess-telemetry
# Optional override; by default sign-in is stored in local app data.
# OFFLINE_CHESS_DASHBOARD_PASSWORD_FILE=C:\Users\YOUR_NAME\AppData\Local\OfflineChess\dashboard-password.json
